---
/**
 * Base.astro — the document shell for wickedagile.com
 *
 * Holds the <head> (meta, favicon, global stylesheet) and a no-flash
 * theme-init script that reads localStorage 'wa-theme' and sets data-theme
 * BEFORE paint: 'dark' = Wicked Dark (the default), 'light' = Wicked Light.
 * The faces are self-hosted by the design package (global.css imports it);
 * there is no font CDN. The theme TOGGLE button lives in
 * Topbar; this layout only prevents the flash.
 *
 * Note: the source has no global film-grain / grid overlay — the only
 * texture (radial grid + accent glow) is scoped to #terminal-section,
 * so it travels with the Hero component, not here.
 */
const {
  title = 'wickedagile — the best code tells a story',
  description = 'Local-first, AI-native developer tools.',
  bodyClass = '',
  favicon = '/favicon.svg',
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#121212" />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <!-- no-flash theme init: set data-theme before first paint -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('wa-theme') === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#f5f5f4' : '#121212');
      } catch (e) {}
    })();
  </script>
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
