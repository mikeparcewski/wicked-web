---
/**
 * Topbar.astro — fixed nav header. Canonical for the wicked-* family.
 * CSS is is:global so the class names survive and the dropdown / theme
 * scripts still match.
 *
 * Props (per-site):
 *   pkg  — secondary header shown as "<logo> / <pkg>" in jetbrains-mono
 *          (e.g. "wicked-garden"). Omit on the umbrella site.
 *   repo — GitHub URL the header's GitHub icon points at (this page's repo).
 */
import { GH, PLANES } from '../data/family.js';

const {
  pkg = '',
  repo = GH,
} = Astro.props;

/* Single source for the Medium wordmark glyph — referenced by both the desktop
   icon button and the mobile-menu row so the two paths can't drift. */
const MEDIUM_GLYPH_PATH = 'M19.938 5.686L18.651 6.92a.376.376 0 0 0-.143.362v9.067a.376.376 0 0 0 .143.361l1.257 1.234v.271h-6.322v-.27l1.302-1.265c.128-.128.128-.165.128-.36V8.99l-3.62 9.195h-.49L6.69 8.99v6.163a.85.85 0 0 0 .233.707l1.694 2.054v.271H3.815v-.27L5.51 15.86a.82.82 0 0 0 .218-.707V8.027a.624.624 0 0 0-.203-.527L4.019 5.686v-.27h4.674l3.613 7.923 3.176-7.924h4.456v.271z';
const GITHUB_GLYPH_PATH = 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 012-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z';
---

<!-- TOPBAR -->
<header class="topbar">
  <div class="topbar__inner">
    <a href="https://wickedagile.com" class="wordmark" aria-label="wickedagile">
      <!-- the brand mark (packages/design-system/brand/wicked-agile-lockup.svg, its mast + wave + spark),
           drawn in the guide's three tokens so it follows the theme -->
      <svg class="wordmark-mark" viewBox="0 0 36 40" width="22" height="24" aria-hidden="true">
        <path d="M 18 2 L 4 38 L 32 38 Z" fill="none" stroke="var(--ink-primary)" stroke-width="2"/>
        <line x1="18" y1="2" x2="18" y2="38" stroke="var(--ink-primary)" stroke-width="1.5"/>
        <path d="M 0 38 Q 10 31 18 38 T 36 38" fill="none" stroke="var(--accent-primary)" stroke-width="2.5" stroke-linecap="round"/>
        <polygon points="18,0 22,7 14,7" fill="var(--accent-wicked)"/>
      </svg>
      <span class="wordmark-name"><span class="wk">wicked</span> <span class="ag">agile</span></span>
    </a>
    {pkg && (
      <span class="topbar-pkg">
        <span class="topbar-pkg-sep" aria-hidden="true">/</span>{pkg}
      </span>
    )}
    <nav class="nav">
      <div class="dropdown-wrap nav-inline" data-tip="the experiment">
        <button class="icon-btn" id="projectsBtn" aria-label="Browse the experiment" aria-expanded="false" aria-haspopup="true">
          <!-- lab flask — the experiment icon -->
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 1.5h4"/>
            <path d="M6 1.5V5.8L2.4 11.8A1 1 0 0 0 3.3 13.2h7.4A1 1 0 0 0 11.6 11.8L8 5.8V1.5"/>
            <circle cx="6.2" cy="9.8" r=".5" fill="currentColor" stroke="none"/>
            <circle cx="8.2" cy="11.4" r=".45" fill="currentColor" stroke="none"/>
          </svg>
        </button>
        <div class="dropdown-menu" id="projectsMenu" hidden>
          <span class="dropdown-kicker">The Experiments</span>
          {PLANES.map((p) => (
            <div class="dropdown-plane" style={`--plane:var(--plane-${p.key})`}>
              <span class="dp-head"><span class="dp-dot" aria-hidden="true"></span>{p.name} <span class="dp-note">{p.note}</span></span>
              {p.products.filter((s) => s.hasSite).map((s) => (
                <a href={s.href} class="dropdown-item"><span class="di-label">{s.short} <span class="di-tag">{s.tag}</span></span><span class="dropdown-tag">site ↗</span></a>
              ))}
            </div>
          ))}
        </div>
      </div>
      <a href="https://medium.com/@mike.parcewski" class="icon-btn nav-inline" target="_blank" rel="noopener" aria-label="Medium" data-tip="writing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d={MEDIUM_GLYPH_PATH}/></svg>
      </a>
      <a class="icon-btn nav-inline" href={repo} target="_blank" rel="noopener" aria-label="GitHub" data-tip="github">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d={GITHUB_GLYPH_PATH}/></svg>
      </a>
      <button class="icon-btn" id="themeBtn" aria-label="Toggle theme" data-tip="toggle theme">
        <svg id="themeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></svg>
      </button>
      <button class="icon-btn menu-btn" id="menuBtn" aria-label="Menu" aria-expanded="false" aria-controls="mobileMenu">
        <svg class="menu-ic menu-ic--bars" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="menu-ic menu-ic--x" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
    </nav>
  </div>

  <!-- MOBILE MENU — the expand version of the nav, phones only -->
  <nav class="mobile-menu" id="mobileMenu" aria-label="the wicked experiment" hidden>
    <span class="dropdown-kicker">The Experiments</span>
    {PLANES.map((p) => (
      <>
        <span class="mm-plane" style={`--plane:var(--plane-${p.key})`}><span class="dp-dot" aria-hidden="true"></span>{p.name}</span>
        {p.products.filter((s) => s.hasSite).map((s) => (
          <a href={s.href} class="mm-item"><span class="mm-label">{s.short} <span class="di-tag">{s.tag}</span></span><span class="dropdown-tag">site ↗</span></a>
        ))}
      </>
    ))}
    <div class="dropdown-divider"></div>
    <a href="https://medium.com/@mike.parcewski" target="_blank" rel="noopener" class="mm-item"><span class="mm-label"><svg class="mm-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={MEDIUM_GLYPH_PATH}/></svg>Medium</span> <span class="dropdown-tag">writing ↗</span></a>
    <a href={repo} target="_blank" rel="noopener" class="mm-item"><span class="mm-label"><svg class="mm-glyph" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={GITHUB_GLYPH_PATH}/></svg>GitHub</span> <span class="dropdown-tag">this repo ↗</span></a>
  </nav>
</header>

<style is:global>
/* TOPBAR */
.topbar{position:fixed;top:0;left:0;right:0;z-index:200;height:var(--topbar-h);background:color-mix(in oklab,var(--surface-base) 92%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--hairline-strong)}
.topbar__inner{display:flex;align-items:center;justify-content:space-between;height:100%;padding:0 clamp(16px,4vw,28px);max-width:1240px;margin:0 auto}
.wordmark{display:inline-flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none}
/* the wordmark is the one place Wicked Serif is set (--font-wordmark), capitalised like studio's "Wicked Studio" */
.wordmark-name{font-family:var(--font-wordmark);font-size:var(--text-section);font-weight:var(--weight-regular);text-transform:capitalize;font-synthesis:none;white-space:nowrap}
.wordmark-mark{display:block;flex-shrink:0;overflow:visible}
.wordmark .wk{color:var(--ink)}
.wordmark .ag{color:var(--ink)}
/* secondary header: "<logo> / <package>" in jetbrains-mono. margin-right:auto
   keeps logo+pkg grouped on the left and pushes the nav to the right. */
.topbar-pkg{display:inline-flex;align-items:center;gap:8px;margin-left:7px;margin-right:auto;font-family: var(--font-sans);font-weight: var(--weight-strong);font-size: var(--text-body);color:var(--muted)}
.topbar-pkg-sep{color:var(--faint);font-weight: var(--weight-regular)}
@media(max-width:560px){.topbar-pkg{display:none}}
.nav{display:flex;align-items:center;gap:12px}
[data-tip]{position:relative}
[data-tip]::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--surface-overlay);color:var(--ink-high);border:1px solid var(--border);font-family: var(--font-sans);font-size: var(--text-caption);white-space:nowrap;padding:4px 9px;border-radius:5px;border:1px solid var(--hairline-strong);pointer-events:none;opacity:0;transition:opacity .18s;z-index:300}
[data-tip]:hover::after{opacity:1}
.icon-btn{display:inline-grid;place-items:center;width:36px;height:36px;border-radius:999px;border:1px solid var(--hairline-strong);color:var(--ink);background:transparent;cursor:pointer;text-decoration:none;transition:border-color .25s var(--ease),color .25s var(--ease),background .25s var(--ease);padding:0;font-size:inherit;text-transform:none;flex-shrink:0}
.icon-btn:hover{border-color:var(--accent);background:var(--accent);color:var(--accent-ink)}
.icon-btn svg{display:block}
.dropdown-wrap{position:relative}
.dropdown-menu{position:absolute;top:calc(100% + 8px);right:0;z-index:200;min-width:252px;background:var(--surface);border:1px solid var(--hairline-strong);border-radius:12px;padding:6px;box-shadow:0 18px 48px -14px rgba(0,0,0,.7)}
/* 4 plane groups + 5 product rows can outgrow short viewports;
   the topbar is fixed, so a clipped menu leaves items unreachable — cap height
   and scroll inside instead */
#projectsMenu.dropdown-menu{max-height:calc(100vh - var(--topbar-h) - 24px);overflow-y:auto}
.dropdown-kicker{display:block;font-family: var(--font-sans);font-size: var(--text-caption);color:var(--muted);padding:7px 10px 5px}
/* a PLANE group: a colored head (dot + name + role note), its products beneath.
   --plane is set inline per group from the shared plane tokens. */
.dropdown-plane{padding:3px 0 2px;border-top:1px solid var(--hairline)}
.dropdown-plane:first-of-type{border-top:none}
.dp-head{display:flex;align-items:center;gap:7px;padding:5px 10px 3px;font-family: var(--font-sans);font-size: var(--text-caption);font-weight: var(--weight-strong);color:color-mix(in oklab,var(--plane,var(--accent)) 72%,var(--ink))}
.dp-dot{width:7px;height:7px;border-radius:50%;background:var(--plane,var(--accent));box-shadow:0 0 8px -1px var(--plane,var(--accent));flex-shrink:0}
.dp-note{margin-left:auto;font-weight: var(--weight-regular);text-transform:none;color:var(--faint)}
.dropdown-item{display:flex;justify-content:space-between;align-items:center;padding:7px 10px 7px 24px;border-radius:6px;color:var(--ink);font-size: var(--text-body);text-decoration:none;transition:background .15s,color .15s}
.dropdown-item:hover{background:color-mix(in oklab,var(--plane,var(--accent)) 14%,transparent);color:var(--ink)}
.dropdown-tag{font-family: var(--font-sans);font-size: var(--text-caption);color:var(--faint);flex-shrink:0}
.di-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.di-tag{color:var(--muted);font-family: var(--font-sans);font-weight: var(--weight-regular);font-size: var(--text-caption);}
.dropdown-divider{height:1px;background:var(--hairline);margin:4px 0}

/* ── MOBILE EXPAND NAV (hamburger) ─────────────────────────────────────────
   Desktop: inline icon cluster (.nav-inline) shows, hamburger + panel hidden.
   Phones ≤640px: collapse ecosystem/Medium/GitHub behind a hamburger; the
   theme toggle stays inline. Prevents the right-edge clip on small screens. */
.menu-btn{display:none}
.menu-btn .menu-ic--x{display:none}
.menu-btn[aria-expanded="true"] .menu-ic--bars{display:none}
.menu-btn[aria-expanded="true"] .menu-ic--x{display:block}
.mobile-menu{display:none}
.mobile-menu .dropdown-kicker{padding:11px 12px 6px}
.mobile-menu .dropdown-divider{margin:6px 10px}
/* plane group head on mobile — same dot + colored name as the desktop menu */
.mm-plane{display:flex;align-items:center;gap:8px;padding:10px 12px 2px;font-family: var(--font-sans);font-size: var(--text-caption);font-weight: var(--weight-strong);color:color-mix(in oklab,var(--plane,var(--accent)) 72%,var(--ink))}
.mm-item{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:46px;padding:11px 12px 11px 27px;border-radius:8px;color:var(--ink);font-family: var(--font-sans);font-weight: var(--weight-strong);font-size: var(--text-lead);text-decoration:none;transition:background .15s}
.mm-item:hover,.mm-item:active{background:var(--accent-wash)}
/* the writing/repo rows after the divider sit outside the plane groups — unindent */
.mobile-menu .dropdown-divider ~ .mm-item{padding-left:12px}
/* mirror .di-label so a long crew label truncates instead of overflowing the row */
.mm-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* Medium row: small inline brand glyph so it reads like the other rows (which
   carry an identity) instead of a bare word. Sized in em so it tracks the label
   font and scales with any viewport clamp on the row text. */
.mm-glyph{width:.95em;height:.95em;margin-right:.5em;vertical-align:-.13em;opacity:.82;flex-shrink:0;transition:opacity .15s}
.mm-item:hover .mm-glyph,.mm-item:active .mm-glyph{opacity:1}
.mm-item .dropdown-tag{font-family: var(--font-sans);font-weight: var(--weight-regular);font-size: var(--text-caption);color:var(--faint);flex-shrink:0}
@keyframes mm-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:640px){
  .nav{gap:8px}
  .nav-inline{display:none}
  .menu-btn{display:inline-grid}
  .mobile-menu:not([hidden]){display:block;position:fixed;top:var(--topbar-h);left:0;right:0;z-index:199;background:var(--surface);border-bottom:1px solid var(--hairline-strong);box-shadow:0 18px 48px -14px rgba(0,0,0,.7);padding:8px 14px calc(14px + env(safe-area-inset-bottom));max-height:calc(100svh - var(--topbar-h));overflow-y:auto;animation:mm-in .2s var(--ease)}
}
@media(prefers-reduced-motion:reduce){.mobile-menu:not([hidden]){animation:none}}
</style>

<script is:inline>
(function () {
  'use strict';

  /* THEME */
  var SUN = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  var MOON = '<path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>';
  function setTheme(t){t=t==='light'?'light':'dark';document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('wa-theme',t)}catch(e){}var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='light'?'#f5f5f4':'#121212');var ic=document.getElementById('themeIcon');if(ic)ic.innerHTML=t==='light'?MOON:SUN}
  /* respect the no-flash init already on <html>, falling back to stored/default */
  setTheme(document.documentElement.getAttribute('data-theme')||'dark');
  var themeBtn=document.getElementById('themeBtn');
  if(themeBtn)themeBtn.addEventListener('click',function(){setTheme(document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark')});

  /* DROPDOWN */
  (function(){
    var btn=document.getElementById('projectsBtn'),menu=document.getElementById('projectsMenu');
    if(!btn||!menu)return;
    btn.addEventListener('click',function(e){e.stopPropagation();var o=!menu.hidden;menu.hidden=o;btn.setAttribute('aria-expanded',!o)});
    document.addEventListener('click',function(){menu.hidden=true;btn.setAttribute('aria-expanded','false')});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){menu.hidden=true;btn.setAttribute('aria-expanded','false')}});
  })();

  /* MOBILE MENU (hamburger expand nav) */
  (function(){
    var mb=document.getElementById('menuBtn'),mm=document.getElementById('mobileMenu');
    if(!mb||!mm)return;
    function closeMenu(){mm.hidden=true;mb.setAttribute('aria-expanded','false')}
    mb.addEventListener('click',function(e){e.stopPropagation();if(mm.hidden){mm.hidden=false;mb.setAttribute('aria-expanded','true')}else{closeMenu()}});
    mm.addEventListener('click',function(e){e.stopPropagation()});
    document.addEventListener('click',closeMenu);
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeMenu()});
    window.addEventListener('resize',function(){if(window.innerWidth>640)closeMenu()});
  })();
})();
</script>
