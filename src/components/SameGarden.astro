---
/**
 * SameGarden.astro — THE four-plane map. The one canonical framing of the
 * wicked platform, embeddable on every family site:
 *
 *   two skins, one control plane, one catalog, one record.
 *
 *     studio ◄─────► interactive    EXPERIENCE   two front doors, one project model
 *            crew                   CONTROL      intent in → verified work out
 *           garden                  CAPABILITY   the catalog agents act through
 *           estate                  FOUNDATION   the system of record
 *
 * Planes stack top-to-bottom with the CONTRACT between each pair named on the
 * seam. Retired/absorbed packages get no card: testing's skills live in garden
 * (the qe fleet) and its gate lives in crew; bus/vault/ledger are internal to
 * the foundation; wicked-core is the engine inside crew.
 *
 * INTERACTION MODEL (CSS-only — no JS, so it degrades and travels well):
 *   - hover OR keyboard-focus into a plane → the plane lights in its hue
 *     (border, glow, role caption) and BOTH adjacent contract seams light up,
 *     showing what flows in and out of that plane.
 *   - sibling planes dim slightly while one is lit (`:has()`; without support
 *     the lit plane still lights — dimming is a progressive garnish).
 *   - keyboard: product links are plain anchors, so Tab walks the map top to
 *     bottom; :focus-within drives the exact same highlight as hover.
 *   - reduced motion: all transitions drop; states still apply instantly.
 *
 * Prop:
 *   current — this site's package name (e.g. "wicked-estate"). That product's
 *             card renders as a non-link "you are here" marker so a site never
 *             promotes itself, while the map stays complete.
 */
const { current = '' } = Astro.props;

const GH = 'https://github.com/mikeparcewski';

const PLANES = [
  {
    key: 'experience',
    name: 'Experience',
    role: 'Two front doors, one project model',
    owns: 'Rendering and editing surfaces — nothing semantic lives here.',
    products: [
      {
        name: 'wicked-interactive', kind: 'creator skin',
        href: 'https://wi.wickedagile.com', repo: `${GH}/wicked-interactive`, hasSite: true,
        blurb: 'Describe it, watch it build in-browser, point at what to change. Ships HTML, PDF, decks, video.',
      },
      {
        name: 'studio', kind: 'coder skin',
        href: `${GH}/wicked-crew/tree/main/packages/studio`, repo: `${GH}/wicked-crew/tree/main/packages/studio`, hasSite: false,
        blurb: 'The run board: submit intent, watch phases, answer gates. A pure client of crew’s API — ships inside wicked-crew.',
      },
    ],
    contract: 'submit intent · watch the run · answer gates — one crew API, both skins are pure clients',
  },
  {
    key: 'control',
    name: 'Control',
    role: 'Intent in, verified work out',
    owns: 'Orchestration, governance, gates — runs the coding agents you already use as governed workers.',
    products: [
      {
        name: 'wicked-crew', kind: 'the control plane',
        href: 'https://wc.wickedagile.com', repo: `${GH}/wicked-crew`, hasSite: true,
        blurb: 'Evaluator ≠ creator — no agent grades its own homework. “Done” is re-derived from evidence, never asserted. Workflows are data.',
      },
    ],
    contract: 'invokes skills as governed workers — deny dominates, every verdict lands in the record',
  },
  {
    key: 'capability',
    name: 'Capability',
    role: 'The catalog — what agents can do',
    owns: 'Skills, tools, playbooks, councils; the QE specialist fleet. The only sanctioned way agents touch the record.',
    products: [
      {
        name: 'wicked-garden', kind: 'the catalog',
        href: 'https://wg.wickedagile.com', repo: `${GH}/wicked-garden`, hasSite: true,
        blurb: 'Multi-model review councils, graph-aware refactors, repo playbooks — plus an open naming contract to ship your own pack.',
      },
    ],
    contract: 'reads & writes the record through its contract — never around it',
  },
  {
    key: 'foundation',
    name: 'Foundation',
    role: 'The system of record',
    owns: 'Code graph · memory · knowledge · evidence · events. Zero-infra and local-first today; a team profile is on the roadmap.',
    products: [
      {
        name: 'wicked-estate', kind: 'the record',
        href: 'https://we.wickedagile.com', repo: `${GH}/wicked-estate`, hasSite: true,
        blurb: 'A 102-language code graph, memory, and knowledge in one binary (MCP) — including the injected edges grep never sees.',
      },
    ],
    contract: null,
  },
].map((p) => ({
  ...p,
  products: p.products.map((s) => ({
    ...s,
    here: s.name === current,
    // string ops, not a regex literal: the Astro 4 compiler mis-parses regex
    // literals in shared-component frontmatter when imported via alias (see
    // the README gotcha) — consumer sites still run Astro 4.
    url: s.href.replace('https://', '').replace('http://', ''),
  })),
}));
---

<section class="same-garden" aria-labelledby="sg-h">
  <div class="sg-inner">
    <div class="sg-head">
      <span class="kicker sg-kicker">The wicked platform</span>
      <h2 class="sg-h2" id="sg-h">Two skins. One control plane.<br>One catalog. One record.</h2>
      <p class="sg-sub">Four planes, four contracts. Hover or tab through a plane to see its role and what crosses its seams — every cross-plane interaction goes through the contract, never around it.</p>
    </div>

    <div class="sg-map">
      {PLANES.map((p) => (
        <>
          <div class={`sg-plane sg-plane--${p.key}`} style={`--plane:var(--plane-${p.key})`}>
            <div class="sg-plane-rail">
              <span class="sg-plane-node" aria-hidden="true"></span>
              <span class="sg-plane-name">{p.name}</span>
              <span class="sg-plane-role">{p.role}</span>
              <span class="sg-plane-owns">{p.owns}</span>
            </div>
            <div class="sg-plane-cards" data-count={p.products.length}>
              {p.products.map((s) => (
                <div class={`sg-card${s.here ? ' sg-card--here' : ''}`}>
                  <span class="sg-card-glow" aria-hidden="true"></span>
                  <div class="sg-card-body">
                    <span class="sg-eyebrow"><span class="sg-dot" aria-hidden="true"></span>{s.name}<span class="sg-kind">{s.kind}</span></span>
                    <p class="sg-blurb">{s.blurb}</p>
                  </div>
                  <div class="sg-card-foot">
                    {s.here ? (
                      <span class="sg-here-chip">you are here</span>
                    ) : (
                      <span class="sg-links">
                        {s.hasSite && (
                          <a class="sg-visit sg-primary" href={s.href} aria-label={`Visit ${s.name}`}>{s.url}<span class="sg-arrow">↗</span></a>
                        )}
                        <a class={`sg-repo${s.hasSite ? '' : ' sg-primary'}`} href={s.repo} target="_blank" rel="noopener" aria-label={`${s.name} on GitHub`}>
                          <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 012-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>{s.hasSite ? 'repo' : 'in wicked-crew ↗'}</a>
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
          {p.contract && (
            <div class="sg-contract">
              <span class="sg-contract-line" aria-hidden="true"></span>
              <span class="sg-contract-label">{p.contract}</span>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style is:global>
.same-garden{ border-top:1px solid var(--hairline); padding:clamp(48px,8vh,96px) 0; scroll-snap-align:start; }
.same-garden .sg-inner{ max-width:1240px; margin:0 auto; padding:0 28px; width:100%; }

/* ── section head ───────────────────────────────────────────────────────── */
.same-garden .sg-head{ text-align:center; margin-bottom:clamp(28px,4.5vh,48px); }
.same-garden .sg-kicker{ color:var(--accent); }
.same-garden .sg-kicker::before, .same-garden .sg-kicker::after{ content:''; display:inline-block; width:22px; height:1px; background:var(--accent); vertical-align:middle; margin-bottom:3px; }
.same-garden .sg-kicker::before{ margin-right:10px; } .same-garden .sg-kicker::after{ margin-left:10px; }
.same-garden .sg-h2{ font-family:var(--font-display); font-weight:900; font-stretch:125%; font-size:clamp(1.9rem,3.8vw,2.9rem); color:var(--ink); margin:12px 0 0; letter-spacing:-.02em; line-height:1.04; }
.same-garden .sg-sub{ font-family:var(--font-mono); font-size:.74rem; color:var(--muted); margin:14px auto 0; max-width:72ch; line-height:1.6; }

/* ── the map: plane bands with contract seams between ───────────────────── */
.same-garden .sg-map{ display:flex; flex-direction:column; max-width:980px; margin:0 auto; }

/* one PLANE band — --plane is its hue (from the shared plane tokens) */
.same-garden .sg-plane{
  display:grid; grid-template-columns:minmax(196px,236px) minmax(0,1fr); gap:22px; align-items:start;
  border:1px solid var(--hairline-strong); border-left:3px solid color-mix(in oklab, var(--plane) 55%, var(--hairline-strong));
  border-radius:14px; padding:clamp(14px,2vh,20px) clamp(14px,2vw,22px);
  background:color-mix(in oklab, var(--surface) 62%, transparent);
  transition:border-color .28s var(--ease), background .28s var(--ease), box-shadow .28s var(--ease), opacity .28s var(--ease);
}
/* LIT: hover or keyboard focus anywhere inside the plane */
.same-garden .sg-plane:hover,
.same-garden .sg-plane:focus-within{
  border-color:color-mix(in oklab, var(--plane) 60%, var(--hairline-strong));
  border-left-color:var(--plane);
  background:color-mix(in oklab, var(--surface) 82%, transparent);
  box-shadow:0 0 0 1px color-mix(in oklab, var(--plane) 26%, transparent), 0 24px 56px -30px var(--plane);
}
/* sibling planes recede while one is lit (progressive — needs :has) */
.same-garden .sg-map:has(.sg-plane:hover) .sg-plane:not(:hover):not(:focus-within),
.same-garden .sg-map:has(.sg-plane:focus-within) .sg-plane:not(:focus-within):not(:hover){ opacity:.55; }

/* plane rail: node + name + role + owns */
.same-garden .sg-plane-rail{ display:flex; flex-direction:column; gap:7px; min-width:0; }
.same-garden .sg-plane-node{ width:12px; height:12px; border-radius:50%; border:2px solid var(--plane); background:var(--surface); box-shadow:0 0 0 4px color-mix(in oklab, var(--plane) 12%, transparent); transition:background .28s var(--ease); }
.same-garden .sg-plane:hover .sg-plane-node,
.same-garden .sg-plane:focus-within .sg-plane-node{ background:var(--plane); }
.same-garden .sg-plane-name{ font-family:var(--font-display); font-weight:900; font-stretch:110%; font-size:1.32rem; letter-spacing:-.01em; color:var(--ink); line-height:1; }
.same-garden .sg-plane-role{ font-family:var(--font-mono); font-size:.62rem; letter-spacing:.1em; text-transform:uppercase; font-weight:700; color:color-mix(in oklab, var(--plane) 78%, var(--ink)); line-height:1.4; }
.same-garden .sg-plane-owns{ font-size:.76rem; line-height:1.5; color:var(--muted); max-width:26ch; }

/* product cards inside a plane (two side-by-side for the skins) */
.same-garden .sg-plane-cards{ display:grid; grid-template-columns:1fr; gap:12px; min-width:0; }
.same-garden .sg-plane-cards[data-count="2"]{ grid-template-columns:repeat(2,minmax(0,1fr)); }
.same-garden .sg-card{
  position:relative; display:flex; flex-direction:column; overflow:hidden; isolation:isolate;
  border:1px solid var(--hairline-strong); border-radius:11px;
  background:color-mix(in oklab, var(--canvas) 42%, transparent);
  transition:border-color .28s var(--ease), transform .28s var(--ease);
}
.same-garden .sg-card:hover,
.same-garden .sg-card:focus-within{ border-color:color-mix(in oklab, var(--plane) 52%, var(--hairline-strong)); transform:translateY(-3px); }
.same-garden .sg-card--here{ border-style:dashed; }
.same-garden .sg-card--here:hover{ transform:none; }
.same-garden .sg-card-glow{ position:absolute; inset:0; z-index:-1; pointer-events:none; opacity:0; transition:opacity .28s var(--ease);
  background:radial-gradient(ellipse 66% 82% at 100% 0%, color-mix(in oklab, var(--plane) 15%, transparent), transparent 62%); }
.same-garden .sg-card:hover .sg-card-glow,
.same-garden .sg-card:focus-within .sg-card-glow,
.same-garden .sg-plane:focus-within .sg-card-glow{ opacity:1; }
.same-garden .sg-card-body{ flex:1; padding:13px 14px 10px; }
.same-garden .sg-eyebrow{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; font-family:var(--font-mono); font-size:.7rem; font-weight:700; letter-spacing:.05em; color:var(--ink); }
.same-garden .sg-dot{ width:6px; height:6px; border-radius:50%; background:var(--plane); box-shadow:0 0 8px -1px var(--plane); flex-shrink:0; }
.same-garden .sg-kind{ font-weight:400; font-size:.6rem; letter-spacing:.1em; text-transform:uppercase; color:color-mix(in oklab, var(--plane) 70%, var(--muted)); }
.same-garden .sg-blurb{ font-size:.78rem; line-height:1.55; color:var(--muted); margin:8px 0 0; }
.same-garden .sg-card-foot{ display:flex; align-items:center; justify-content:flex-end; gap:12px; padding:9px 13px 11px; border-top:1px solid var(--hairline); }
.same-garden .sg-links{ display:inline-flex; align-items:center; gap:12px; flex-wrap:wrap; }
.same-garden .sg-visit{ display:inline-flex; align-items:center; gap:5px; font-family:var(--font-mono); font-size:.64rem; letter-spacing:.02em; color:var(--muted); white-space:nowrap; text-decoration:none; transition:color .22s var(--ease); }
.same-garden .sg-arrow{ display:inline-block; transition:transform .22s var(--ease); }
.same-garden .sg-visit:hover,
.same-garden .sg-card:hover .sg-visit{ color:var(--plane); }
.same-garden .sg-card:hover .sg-arrow{ transform:translate(2px,-2px); }
.same-garden .sg-repo{ display:inline-flex; align-items:center; gap:5px; font-family:var(--font-mono); font-size:.62rem; letter-spacing:.03em; color:var(--muted); white-space:nowrap; text-decoration:none; position:relative; z-index:3; transition:color .22s var(--ease); }
.same-garden .sg-repo:hover{ color:var(--ink); }
/* stretched primary link — covers the whole card (site when present, else repo) */
.same-garden .sg-primary::after{ content:''; position:absolute; inset:0; z-index:2; }
.same-garden .sg-repo.sg-primary{ position:static; }
.same-garden .sg-card a:focus-visible{ outline:2px solid var(--plane); outline-offset:3px; border-radius:3px; }
.same-garden .sg-here-chip{ font-family:var(--font-mono); font-size:.6rem; letter-spacing:.14em; text-transform:uppercase; color:color-mix(in oklab, var(--plane) 78%, var(--ink)); border:1px dashed color-mix(in oklab, var(--plane) 45%, var(--hairline-strong)); border-radius:999px; padding:3px 10px; }

/* ── the CONTRACT seam between two planes ───────────────────────────────── */
.same-garden .sg-contract{ display:flex; align-items:center; gap:10px; padding:7px 4px 7px 30px; position:relative; }
.same-garden .sg-contract-line{ position:absolute; left:14px; top:-4px; bottom:-4px; width:2px; border-radius:2px;
  background:linear-gradient(var(--hairline-strong), var(--hairline-strong)); transition:background .28s var(--ease); }
.same-garden .sg-contract-label{ font-family:var(--font-mono); font-size:.62rem; letter-spacing:.06em; color:var(--faint); line-height:1.5; transition:color .28s var(--ease); }
.same-garden .sg-contract::before{ content:'⇅'; font-size:.78rem; line-height:1; color:var(--faint); transition:color .28s var(--ease); }
/* light the seam when EITHER adjacent plane is lit:
   below a lit plane = adjacent-sibling; above a lit plane = :has(+) */
.same-garden .sg-plane:hover + .sg-contract .sg-contract-label,
.same-garden .sg-plane:focus-within + .sg-contract .sg-contract-label,
.same-garden .sg-contract:has(+ .sg-plane:hover) .sg-contract-label,
.same-garden .sg-contract:has(+ .sg-plane:focus-within) .sg-contract-label{ color:var(--ink); }
.same-garden .sg-plane:hover + .sg-contract::before,
.same-garden .sg-plane:focus-within + .sg-contract::before,
.same-garden .sg-contract:has(+ .sg-plane:hover)::before,
.same-garden .sg-contract:has(+ .sg-plane:focus-within)::before{ color:var(--accent); }
.same-garden .sg-plane:hover + .sg-contract .sg-contract-line,
.same-garden .sg-plane:focus-within + .sg-contract .sg-contract-line,
.same-garden .sg-contract:has(+ .sg-plane:hover) .sg-contract-line,
.same-garden .sg-contract:has(+ .sg-plane:focus-within) .sg-contract-line{ background:linear-gradient(color-mix(in oklab, var(--accent) 70%, transparent), color-mix(in oklab, var(--accent) 70%, transparent)); }

/* ── responsive ─────────────────────────────────────────────────────────── */
@media(max-width:860px){
  .same-garden .sg-plane{ grid-template-columns:1fr; gap:12px; }
  .same-garden .sg-plane-owns{ max-width:none; }
  .same-garden .sg-plane-cards[data-count="2"]{ grid-template-columns:1fr; }
  .same-garden .sg-contract{ padding-left:26px; }
}

/* ── reduced motion: keep every state, drop the animation ───────────────── */
@media (prefers-reduced-motion:reduce){
  .same-garden .sg-plane,
  .same-garden .sg-card,
  .same-garden .sg-card-glow,
  .same-garden .sg-visit, .same-garden .sg-arrow, .same-garden .sg-repo,
  .same-garden .sg-plane-node,
  .same-garden .sg-contract-line, .same-garden .sg-contract-label{ transition:none!important; }
  .same-garden .sg-card:hover,
  .same-garden .sg-card:focus-within{ transform:none; }
}
</style>
