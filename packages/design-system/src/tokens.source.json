{
  "$comment": "THE single source of the wicked design tokens. scripts/build.mjs generates dist/tokens.css (light and dark) and dist/tokens.json from it; never edit dist/ by hand. `from` says where each value came from: guide = the operator's accepted default palette (docs/GUIDE.md section 'Sources': ui-mockups README palette table and the derived values in ui-mockups/index.html; appearance.md); brand = a name the brand SVGs reference; studio = wicked-studio's current tokens at 23866dc, used where the guide is silent; web = wicked-web src/styles/tokens.css; derived = chosen by this package where the guide is silent, the reason in `note`. The guide specifies a light ground only, so every dark value is derived; per the operator (2026-10-31) dark is neutral near-black and charcoal, with blue only as a sparing accent.",
  "name": "wicked-design",
  "themes": [
    "light",
    "dark"
  ],
  "groups": {
    "surface": "Page, rail, card, raised and overlay grounds, from deepest to highest.",
    "ink": "Text colours, from quietest to strongest.",
    "border": "Hairlines and the edge of an input field.",
    "accent": "The action colour, its states and the text on it.",
    "brand": "The names the brand lockup and icons reference.",
    "status": "Waiting on you (gate), failed, running, warning, ok, done.",
    "plane": "The four platform planes of the family sites.",
    "elevation": "Shadows, the focus ring and the modal scrim.",
    "space": "The spacing scale.",
    "type": "Families, sizes, weights and line heights.",
    "radius": "Corner radii.",
    "motion": "Easing curves and durations.",
    "control": "Control heights and the touch-target floor."
  },
